{
  "name": "example-authorized-bounty",
  "domain": "example.test",
  "policy": "policy.json",
  "authorized_testing": true,
  "max_leads": 100,
  "recon": {
    "update_templates": false,
    "env": {
      "HTTPX_RPS": "1",
